{
  "name": "tyuiubility",
  "displayName": "Tyuiubility",
  "version": "1.0.3",
  "description": "Расширение для удобства пользования сервисами ТИУ.",
  "author": "incerstyle",
  "scripts": {
    "dev:chrome": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox",
    "build:chrome": "plasmo build",
    "build:firefox": "plasmo build --target=firefox",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "package:chrome": "plasmo package",
    "package:firefox": "plasmo package --target=firefox",
    "package": "pnpm package:chrome && pnpm package:firefox"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.1.37",
    "@types/node": "25.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "plasmo": "0.90.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "manifest": {
    "web_accessible_resources": [
      {
        "resources": [ "*.png", "*.jpg", "*.svg" ], 
        "matches": [ "https://my.tyuiu.ru/*" ]
      }
    ],
    "permissions": [
      "storage"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "tyuiubility@incerstyle.ru",
        "data_collection_permissions": {
           "required": ["none"]
        }
      }
    },
    "host_permissions": [
      "https://my.tyuiu.ru/schedule*"
    ]
  }
}
